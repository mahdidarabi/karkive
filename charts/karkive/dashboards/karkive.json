                      "value": 0
                    },
                    {
                      "color": "orange",
                      "value": 28800
                    },
                    {
                      "color": "red",
                      "value": 129600
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
